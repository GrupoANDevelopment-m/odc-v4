# .gitignore — exclude heavy/unnecessary artifacts
.venv/
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Build / cache
dist/
build/
.pytest_cache/
.coverage
htmlcov/
*.log

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Runtime data (per-instance, never share)
data/
runs/
scratch/
*.db
*.sqlite
*.sqlite3

# Local .env (never share secrets!)
.env
.env.local
.odc_data/
logs/

# Specific transient paths
/.odc_data_real_run/
.odc_data_real_run
/.odc_data_browser_test/
/odc_browser_test/
/tmp/odc_browser_test/

# NOTE: third_party/* IS COMMITTED — these are real upstream sources
# we bundle for offline reference and provenance. Removing them would
# make the repo lie about its real size and capabilities.
