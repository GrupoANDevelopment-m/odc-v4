# ODC v4 — environment variables template
# Copy to .env and fill in your keys: cp .env.example .env

# === LLM Provider ===
# Choose one: nvidia | openai | anthropic | gemini | ollama
ODC_LLM_PROVIDER=nvidia
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# === API Keys (set the ones you have) ===
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# === Local Brain (Ollama) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# === Storage ===
ODC_DATA_DIR=./.odc_data

# === Server ===
ODC_HOST=127.0.0.1
ODC_PORT=8000

# === Web / Security ===
ODC_WEB_ALLOW_ORIGINS=*
ODC_REQUIRE_SAFETY=true       # DO NOT change to false

# === Auto-extension ===
ODC_AUTO_EXTEND_DEFAULT=true  # dynamic.tool_create etc. enable by default
ODC_REQUIRE_CONFIRM_SHELL=true
ODC_REQUIRE_CONFIRM_WRITE=true

# === Self-heal ===
ODC_SELF_HEAL_ENABLED=true
ODC_SELF_HEAL_LLM_PROVIDER=nvidia  # which provider to use for self-heal LLM

# === Logging ===
ODC_LOG_LEVEL=INFO
ODC_LOG_FILE=./logs/odc.log

# === MCP / OSINT (optional) ===
# See odc/osint/ for full list of endpoints and which need keys
GITHUB_TOKEN=
WEATHER_LAT=48.8566  # Paris
WEATHER_LON=2.3522
