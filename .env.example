# ============================================================
# ODC v4 — environment template
# Copy to .env and fill in the values you actually use.
# ============================================================

# --- LLM provider (pick one or more) -----------------------------
# Default provider if none specified in CLI
ODC_LLM_PROVIDER=anthropic          # anthropic | openai | ollama

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# OpenAI (GPT)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b

# NVIDIA (OpenAI-compatible, free tier available)
NVIDIA_API_KEY=nvapi-...
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-70b-instruct
# Other models: mistralai/mixtral-8x7b-instruct-v0.1, google/gemma-2-9b-it,
#               meta/llama-3.1-8b-instruct, microsoft/phi-3-medium-4k-instruct

# --- Limits / behavior -------------------------------------------
ODC_MAX_LOOP_TURNS=25               # hard ceiling on loop iterations per task
ODC_MAX_RETRIES=3                   # per-iteration retries on transient errors
ODC_VERIFY_HARD_CAP=3               # stop after N failed verify cycles
ODC_LOOKUP_BUDGET=2                 # max evidence lookups before asking user
ODC_LOG_LEVEL=INFO
ODC_DATA_DIR=./.odc_data            # memory + skills + cache

# --- Tool toggles ------------------------------------------------
ODC_TOOL_WEB_ENABLED=true
ODC_TOOL_SHELL_ENABLED=true         # sandboxed shell, off by default in prod
ODC_TOOL_BROWSER_ENABLED=false      # requires browser-use install
ODC_TOOL_REACH_ENABLED=false        # requires yt-dlp etc.
ODC_SHELL_ALLOWLIST=                # comma-separated commands allowed in shell
